    {
      "id": "signal-lantern",
      "type": "item",
      "name": "Signal Lantern",
      "source": "Lantern Marsh, first edition",
      "data": {
        "description": "A Signal Lantern is a wondrous item with 3 charges. While holding it, you can take an action and expend 1 charge to send a Marshlight signal for 1 minute. The lantern regains all expended charges at dawn. A shutter changes the signal color without expending a charge. A broken lantern cannot send signals. Amber requests a meeting; blue marks a safe route.",
        "attribution": "Original Outset VTT example content, MIT license. No third-party rules text."
      }
    },
    {
      "id": "marshlight",
      "type": "spell",
      "name": "Marshlight",
      "source": "Lantern Marsh, first edition",
      "data": {
        "description": "Marshlight is a level 1 Illusion spell. Casting Time: Action. Range: 30 feet. Components: V, S. Duration: 1 minute. Choose one visible post within range. It shines blue, marking a safe route for the duration. The light ends early if the post is submerged. It deals no damage.",
        "level": 1,
        "attribution": "Original Outset VTT example content, MIT license. No third-party rules text."
      }

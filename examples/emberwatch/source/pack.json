    {
      "id": "emberkin",
      "type": "race",
      "name": "Emberkin",
      "systemId": "dnd-srd-5-2-1",
      "source": "Emberwatch, original homebrew 0.2.0",
      "data": {
        "description": "Emberkin descend from families who kept the volcanic watchfires burning through a century of winter. Their eyes resemble banked coals. Size: Medium. Speed: 35 feet. Darkvision: 60 feet. Banked Ember: your Hit Point maximum increases by 1 at level 1 and again whenever you gain a character level. Ember Gift: you know Fire Bolt from level 1; choose Intelligence, Wisdom, or Charisma for its spellcasting ability.",
        "attribution": "Original Outset VTT example content, MIT license. References the separately attributed SRD Fire Bolt entry."
      },
      "structured": {
        "kind": "race",
        "speed": 35,
        "sizeOptions": [
          "Medium"
        ],
        "darkvisionRangeFeet": 60,
        "hitPointMaximumBonus": {
          "perCharacterLevel": 1,
          "label": "Banked Ember"
        },
        "choiceGroups": [
          {
            "id": "ember-gift",
            "label": "Ember Gift",
            "count": 1,
            "spellcastingAbilities": [
              "intelligence",
              "wisdom",
              "charisma"
            ],
            "options": [
              {
                "id": "spark",
                "label": "Spark",
                "grants": {
                  "label": "Ember Gift",
                  "spells": [
                    {
                      "packId": "dnd-srd-5-2-1-spells",
                      "entryId": "fire-bolt",
                      "characterLevel": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "emberwatch-wayfinder",
      "type": "background",
      "name": "Emberwatch Wayfinder",
      "systemId": "dnd-srd-5-2-1",
      "source": "Emberwatch, original homebrew 0.2.0",
      "data": {
        "description": "You carried evacuation maps between Emberwatch signal towers, reading smoke and terrain before choosing a safe route. Ability scores: Dexterity, Constitution, Wisdom; increase one by 2 and another by 1, or each by 1. Skills: Perception and Survival. Origin feat: Alert. Tool proficiency: Cartographer's Tools. Equipment: Cartographer's Tools, Traveler's Clothes, Rope, 5 Torches, and 10 GP. Alert attaches as a feat; verify its initiative bonus separately.",
        "attribution": "Original Outset VTT example content, MIT license. References separately attributed SRD feat and equipment entries."
      },
      "structured": {
        "kind": "background",
        "abilityScoreOptions": [

    {
      "id": "cinderward-brooch",
      "type": "item",
      "name": "Cinderward Brooch",
      "systemId": "dnd-srd-5-2-1",
      "source": "Emberwatch, original homebrew 0.2.0",
      "data": {
        "description": "Wondrous item, uncommon; requires attunement. A volcanic-glass pin remembers the warmth of the old watchfires. While worn and attuned, you gain a +1 bonus to Armor Class. The brooch has 3 charges. While worn and attuned, take an Action and spend 1 charge to gain 5 Temporary Hit Points, keeping a higher existing temporary total. It regains all spent charges at dawn. Weight: 0.1 lb.",
        "attribution": "Original Outset VTT example content, MIT license."
      },
